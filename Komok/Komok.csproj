<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <Target Name="BuildReactClient" BeforeTargets="Build">
    <Exec Command="npm ci --prefix &quot;$(MSBuildProjectDirectory)/client&quot;" Condition="!Exists('$(MSBuildProjectDirectory)/client/node_modules')" />
    <Exec Command="npm run build --prefix &quot;$(MSBuildProjectDirectory)/client&quot;" />
  </Target>

</Project>
